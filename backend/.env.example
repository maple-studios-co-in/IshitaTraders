# Ishita Traders API settings. Copy this file to .env and fill in real values. Never commit .env.
# Every value is checked at startup (src/config/env.js); a bad one stops the server with a message.

# development | test | production
NODE_ENV=development
PORT=4000
# Defaults to localhost in development and 0.0.0.0 in production.
HOST=
# Number of proxies in front of the API: 0 locally, 1 on Vercel / Render / Railway.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL. Locally: the dev database (see README). In production: the website's Neon database,
# e.g. postgres://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full (on Vercel, the pooled
# "-pooler" address is best).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_MAX=10

# Websites allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3070
# The website's address, used to turn uploaded-media paths into full URLs.
PUBLIC_SITE_URL=http://localhost:3070

# Secret for hashing visitor IPs (16+ characters). Required in production; use the website's
# AUTH_SECRET so both hash the same visitor alike.
IP_HASH_SECRET=
# Requests per visitor per 15 minutes, across the API.
API_RATE_LIMIT=300
# Enquiries per visitor per window.
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_MINUTES=10

# Enables /api/v1/admin/* (Authorization: Bearer <key>). 32+ random characters; empty = disabled.
ADMIN_API_KEY=
# Optional: POST every new enquiry to this URL (Zapier, Make, a CRM). The secret signs the body.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
