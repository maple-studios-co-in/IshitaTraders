# ─────────────────────────────────────────────────────────────────────────────
# Ishita Traders — environment variables
# Copy to .env.local for local development. In production, set them in the host's dashboard
# (Hostinger: the app's Environment variables, see docs/deploy-hostinger.md; Vercel: Project → Settings).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph, links in alert emails).
# REQUIRED for production builds outside Vercel: the build stops without it. Locally: http://localhost:3070
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Admin (/admin) ───────────────────────────────────────────────────────────
# PostgreSQL connection string. REQUIRED in production (Neon recommended: use the pooled URL).
# Remote databases are always reached with sslmode=verify-full (the certificate is checked).
# Leave empty locally: the dev server uses an embedded database in ~/.ishita-traders/pglite.
DATABASE_URL=

# First owner account — created on the first sign-in while no users exist. Change the password
# afterwards under Admin → Your account if you like.
ADMIN_EMAIL=owner@your-domain.com
ADMIN_PASSWORD=
ADMIN_NAME="Amit Kumar"

# Long random string used to hash visitor IPs and sign webhook checks: `openssl rand -base64 32`.
# Set it in production; without it the admin password is used in its place.
AUTH_SECRET=

# Optional: proxies in front of the site that append to X-Forwarded-For (default 1 = Vercel or
# Hostinger alone). Raise it only when another proxy/CDN sits in front, or rate limits lump visitors together.
# TRUSTED_PROXY_HOPS=1
# Optional: a header the host's proxy OVERWRITES with the visitor's address (e.g. x-real-ip), used instead.
# CLIENT_IP_HEADER=

# Optional: admin session cookies are Secure (HTTPS-only) in every production build. Set to false only
# to try a production build over plain http on another device.
# ADMIN_SECURE_COOKIES=

# Optional: Vercel Blob store token. Uploaded images/PDFs then live on Blob's CDN instead of the database.
BLOB_READ_WRITE_TOKEN=

# Optional: local embedded-database folder (keep it OUT of OneDrive/Dropbox-synced folders).
# LOCAL_DATA_DIR=

# ── Email alerts (Resend, https://resend.com) ────────────────────────────────
# New enquiries (and, if enabled, inbox messages) are emailed to the addresses set in
# Admin → Site content → Email alerts. FROM must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Ishita Traders Website <website@your-domain.com>"
CONTACT_TO_EMAIL=ishitatraders2014@gmail.com

# Optional: also POST every new enquiry as JSON to a webhook (Zapier, Make, Google Sheets script, CRM…).
CONTACT_WEBHOOK_URL=

# ── Inbox integrations (Admin → Integrations shows each webhook URL) ─────────
# WhatsApp Cloud API: verify token you choose in Meta's webhook settings, and the app secret
# (used to check Meta's X-Hub-Signature-256 on every delivery).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Inbound email (Resend/Postmark/SendGrid/Cloudflare Email Worker → POST JSON) shared secret.
INBOUND_EMAIL_SECRET=
# SMS gateway (MSG91, Twilio, Exotel…) → POST shared secret.
SMS_WEBHOOK_SECRET=

# ── Website extras ───────────────────────────────────────────────────────────
# Optional default for the "solar system video tour" button (editable later in Admin → Site content).
NEXT_PUBLIC_SOLAR_TOUR_VIDEO_URL=
