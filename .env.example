# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: YouTube/Vimeo *embed* URL for the "solar system video tour" play button.
# e.g. https://www.youtube-nocookie.com/embed/VIDEO_ID?autoplay=1
NEXT_PUBLIC_SOLAR_TOUR_VIDEO_URL=

# Contact form delivery — configure ONE option (in production the form reports an error if neither is set).
# Option A: email via Resend (https://resend.com). FROM must be a verified sender domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Ishita Traders Website <website@your-domain.com>"
CONTACT_TO_EMAIL=ishitatraders2014@gmail.com

# Option B: POST the enquiry as JSON to a webhook (Zapier, Make, Google Apps Script, CRM…).
CONTACT_WEBHOOK_URL=
